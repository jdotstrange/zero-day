# 0-Day Environment Variables
# Copy this file to `.env` and fill in values as needed.
# Only variables prefixed with VITE_ are exposed to the browser (Vite convention).

# ---------------------------------------------------------------------------
# App (optional)
# ---------------------------------------------------------------------------

# Public base URL when deploying behind a sub-path or custom domain.
# VITE_APP_BASE_URL=https://your-domain.com

# ---------------------------------------------------------------------------
# Smart Insights — AI provider (optional, required for live AI features)
# ---------------------------------------------------------------------------
# The demo runs with built-in sample analytics. To connect Smart Insights to a
# real AI service (OpenAI, Anthropic, etc.), add your provider credentials here.
# Usage is billed by the provider — not included with this item.

# VITE_AI_API_KEY=your_api_key_here
# VITE_AI_API_URL=https://api.openai.com/v1
# VITE_AI_MODEL=gpt-4o-mini

# ---------------------------------------------------------------------------
# API backend (optional — template uses mock data by default)
# ---------------------------------------------------------------------------

# VITE_API_BASE_URL=https://api.your-backend.com
