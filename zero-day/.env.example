# 0-Day — environment variables
# Copy to `.env` / `.env.local` and fill in values as needed.
# Vite only exposes variables prefixed with VITE_ to the client.

# --- Microsoft Entra ID (Azure AD) ---
# Required when authConfig.adapter is 'entra' (see src/auth/config.ts).
# Safe to leave blank while using the default mock adapter.
VITE_AZURE_CLIENT_ID=
VITE_AZURE_TENANT_ID=
# Optional; defaults to window.location.origin
VITE_AZURE_REDIRECT_URI=
